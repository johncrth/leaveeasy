// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
//
// 🔑 กฎขั้นต่ำของสัปดาห์ที่ 7 มีข้อเดียว: **ต้องล็อกอินก่อน ถึงจะอ่านหรือเขียนได้**
//
// ⚠️ กฎข้อนี้ยังไม่ใช่ปลอดภัยจริง — ใครสมัครบัญชีใหม่ก็เข้ามาอ่านได้หมด
//    สัปดาห์ที่ 8 จะปิดรายห้องด้วยเช็กลิสต์ 5 ข้อ
//
// 📌 แก้ไฟล์นี้อย่างเดียวไม่พอ ต้อง deploy ขึ้นไปด้วย:  firebase deploy
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ทุกโฟลเดอร์และทุกโฟลเดอร์ย่อย
    match /{document=**} {
      // request.auth != null แปลว่า "คนที่ส่งคำขอมา ล็อกอินอยู่"
      // ถ้าไม่ได้ล็อกอิน ค่านี้จะเป็น null และทุกอย่างจะถูกปฏิเสธ
      allow read, write: if request.auth != null;
    }
  }
}
